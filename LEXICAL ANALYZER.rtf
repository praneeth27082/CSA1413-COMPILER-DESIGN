\pard\sa200\sl276\slmult1\b\f0\fs48\lang9 PSEUDOCODE: LEXICAL ANALYZER\par

\pard\sb280\sa80\cf1\f1\fs40 Aim \fs28 :\par

\pard\sb240\sa240\sl23\slmult0\cf0\b0\fs32 To write and implement a C program to perform lexical analysis and identify different tokens such as keywords, identifiers, constants, operators, and special symbols from a given C statement.\par

\pard\sb280\sa80\cf1\b\fs40 Algorithm\fs28 :\par

\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent360{\pntxtb\'B7}}\fi-360\li720\sb240\sl23\slmult0\cf0\b0\fs32 Start the program.\par

\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent360{\pntxtb\'B7}}\fi-360\li720\sl23\slmult0 Define the list of C keywords.\par
{\pntext\f2\'B7\tab}Read a C statement from the user.\par
{\pntext\f2\'B7\tab}Scan the input character by character.\par
{\pntext\f2\'B7\tab}Ignore white spaces.\par
{\pntext\f2\'B7\tab}If the character is an alphabet or \cf2 _\cf0 , extract the complete word.\par
{\pntext\f2\'B7\tab}Check whether the word is a keyword or an identifier.\par
{\pntext\f2\'B7\tab}If the character is a digit, extract the number and classify it as a constant.\par
{\pntext\f2\'B7\tab}Check and identify arithmetic operators.\par
{\pntext\f2\'B7\tab}Check and identify relational and assignment operators.\par
{\pntext\f2\'B7\tab}Check and identify special symbols.\par
{\pntext\f2\'B7\tab}If the character does not belong to any category, classify it as an unknown symbol.\par
{\pntext\f2\'B7\tab}Continue scanning until the end of the input.\par

\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent360{\pntxtb\'B7}}\fi-360\li720\sa240\sl23\slmult0 Stop the program.\par

\pard\sa240\sl23\slmult0\par

\pard\sa200\sl276\slmult1\b\fs40 Pseudocode :\f0\fs48\par
\b0\fs32 START\par
Read C statement into input\par
Set i = 0\par
WHILE input[i] is not end of string\par
    IF input[i] is a white space\par
        i = i + 1\par
    ELSE IF input[i] is a letter OR '_'\par
        Read letters, digits and '_' to form a word\par
        IF word is a keyword\par
            Print word, "Keyword"\par
        ELSE\par
            Print word, "Identifier"\par
    ELSE IF input[i] is a digit\par
        Read digits and '.' to form a number\par
        Print number, "Constant"\par
    ELSE IF input[i] is '+', '-', '*', '/', '%'\par
        Print input[i], "Arithmetic Operator"\par
        i = i + 1\par
    ELSE IF input[i] is '=', '<', or '>'\par
        IF next character is '='\par
            Print both characters, "Relational Operator"\par
            i = i + 2\par
        ELSE\par
            Print character, "Operator"\par
            i = i + 1\par
    ELSE IF input[i] is '(', ')', '\{', '\}', '[', ']', ';', or ','\par
        Print input[i], "Special Symbol"\par
        i = i + 1\par
    ELSE\par
        Print input[i], "Unknown Symbol"\par
        i = i + 1\par
END WHILE\par
STOP\par
\par
\b\f1\fs40 Program :\fs28\par
\b0\fs32 #include <string.h>\par
#include <ctype.h>\par

\pard\sa200\sl276\slmult1 #include <stdio.h>\par

\pard\sa200\sl276\slmult1\par
int isKeyword(char word[])\par
\{\par
    char keywords[][10] = \{\par
        "int", "char", "float", "double", "if",\par
        "else", "for", "while", "return", "void"\par
    \};\par
\par
    for (int i = 0; i < 10; i++)\par
        if (strcmp(word, keywords[i]) == 0)\par
            return 1;\par
\par
    return 0;\par
\}\par
\par
int main()\par
\{\par
    char input[1000];\par
    int i = 0;\par
\par
    printf("Enter C statement: ");\par
    fgets(input, sizeof(input), stdin);\par
\par
    while (input[i] != '\\0')\par
    \{\par
        if (isspace(input[i]))\par
        \{\par
            i++;\par
        \}\par
\par
        else if (isalpha(input[i]) || input[i] == '_')\par
        \{\par
            char word[50];\par
            int j = 0;\par
\par
            while (isalnum(input[i]) || input[i] == '_')\par
                word[j++] = input[i++];\par
\par
            word[j] = '\\0';\par
\par
            if (isKeyword(word))\par
                printf("%s\\tKeyword\\n", word);\par
            else\par
                printf("%s\\tIdentifier\\n", word);\par
        \}\par
\par
        else if (isdigit(input[i]))\par
        \{\par
            char num[50];\par
            int j = 0;\par
\par
            while (isdigit(input[i]) || input[i] == '.')\par
                num[j++] = input[i++];\par
\par
            num[j] = '\\0';\par
\par
            printf("%s\\tConstant\\n", num);\par
        \}\par
\par
        else if (input[i] == '+' || input[i] == '-' ||\par
                 input[i] == '*' || input[i] == '/' ||\par
                 input[i] == '%')\par
        \{\par
            printf("%c\\tArithmetic Operator\\n", input[i]);\par
            i++;\par
        \}\par
\par
        else if (input[i] == '=' || input[i] == '<' ||\par
                 input[i] == '>')\par
        \{\par
            if (input[i + 1] == '=')\par
            \{\par
                printf("%c%c\\tRelational Operator\\n",\par
                       input[i], input[i + 1]);\par
                i += 2;\par
            \}\par
            else\par
            \{\par
                printf("%c\\tOperator\\n", input[i]);\par
                i++;\par
            \}\par
        \}\par
\par
        else if (input[i] == '(' || input[i] == ')' ||\par
                 input[i] == '\{' || input[i] == '\}' ||\par
                 input[i] == '[' || input[i] == ']' ||\par
                 input[i] == ';' || input[i] == ',')\par
        \{\par
            printf("%c\\tSpecial Symbol\\n", input[i]);\par
            i++;\par
        \}\par
\par
        else\par
        \{\par
            printf("%c\\tUnknown Symbol\\n", input[i]);\par
            i++;\par
        \}\par
    \}\par
\par
    return 0;\par
\}\f0\par

